VITE_BACKEND_URL=https://api.terawallet.app
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_WALLETCONNECT_PROJECT_ID=
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Oblivious HTTP. Leave the relay unset to connect to Tera directly.
# The relay must be run by someone other than whoever runs the API, or the
# wallet refuses it: one party holding both your address and your request is
# exactly what this removes.
VITE_OHTTP_RELAY_URL=
VITE_OHTTP_KEY_CONFIG_URL=
VITE_OHTTP_PATHS=/api/agent/chat,/api/agent/propose

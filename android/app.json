{
  "expo": {
    "name": "Tera Wallet",
    "slug": "tera-wallet",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "terawallet",
    "android": {
      "package": "app.terawallet.android",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.terawallet.ios",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID unlocks your wallet instead of typing your password.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-local-authentication"],
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "e42e623a-3766-41ab-897e-73f808e477b4"
      }
    },
    "owner": "terawallet-org"
  }
}

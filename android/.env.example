EXPO_PUBLIC_API_URL=https://api.terawallet.app
EXPO_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPO_PUBLIC_POLICY_SIGNER_PUBLIC_KEY=0x5b2759f9620f54a5E1651A567Ebd8381F07f9f05

# Tags. Leave unset until TagRegistry is deployed: the app hides every tag
# control rather than offering a lookup it cannot make.
EXPO_PUBLIC_TAG_REGISTRY_ADDRESS=

# JavaScript updates. Unset means the app ships without an update channel and
# the Update button falls back to downloading a new APK. Set it to the
# expo-updates endpoint that serves this app's bundles.
EXPO_PUBLIC_UPDATES_URL=
